# Optional consultation storage path; relative to the project folder.
CONSULTATION_DB=consultation.db
# Foreground wait for a live provider, in seconds (maximum 60; default 25).
CONSULTATION_AI_TIMEOUT_SECONDS=25
# Set to 1 only if a separate scheduler process manages persistent jobs.
CONSULTATION_DISABLE_SCHEDULER=0
# Model credentials continue to use the existing .env and config.yaml router.
# Live AI is enabled per operation in the UI; default operation needs no keys.

# Optional partner-operated gateway. Blank means inactive; no automated dispatch.
# Use an HTTPS endpoint with no query/user credentials. The server sends a
# Bearer token and a stable Idempotency-Key. Never put a token in the URL.
CONSULTATION_DELIVERY_URL=
CONSULTATION_DELIVERY_TOKEN=
